{
  "name": "hadara",
  "version": "0.5.0-rc.3",
  "private": false,
  "license": "MIT",
  "description": "Local-first evidence control plane for trustworthy agentic development, resumable task capsules, and guarded handoffs.",
  "keywords": [
    "ai",
    "agent",
    "agents",
    "coding-agent",
    "developer-tools",
    "cli",
    "workflow",
    "automation",
    "task-management",
    "evidence",
    "handoff",
    "mcp",
    "hadara"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ictseoyoungmin/HADARA.git"
  },
  "homepage": "https://github.com/ictseoyoungmin/HADARA#readme",
  "bugs": {
    "url": "https://github.com/ictseoyoungmin/HADARA/issues"
  },
  "bin": {
    "hadara": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "start": "node dist/cli/main.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:hadara-dev": "vitest run --config vitest.dev.config.ts",
    "test:focused": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:harness": "vitest run tests/harness",
    "test:all": "npm test && npm run test:hadara-dev",
    "check": "npm run build && npm run typecheck:tools && npm run test:all",
    "smoke:context-routing": "node scripts/context-routing-e2e-smoke.mjs",
    "measure:primary-workflow": "node scripts/primary-workflow-measurement.mjs",
    "dev:surface": "node --import tsx tools/dev-surfaces.ts",
    "dev:docker-check": "bash scripts/dev-docker-sync-build.sh --check-only --no-smoke",
    "dev:docker-sync-build": "bash scripts/dev-docker-sync-build.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
