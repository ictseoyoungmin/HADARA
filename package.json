{
  "name": "hadara",
  "version": "0.3.0",
  "private": false,
  "license": "MIT",
  "description": "Portable AI-assisted development workbench for evidence-backed task capsules, handoffs, and release gates.",
  "keywords": [
    "ai",
    "agent",
    "agents",
    "coding-agent",
    "developer-tools",
    "cli",
    "workflow",
    "automation",
    "task-management",
    "evidence",
    "handoff",
    "release-management",
    "mcp",
    "hadara"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ictseoyoungmin/HADARA.git"
  },
  "homepage": "https://github.com/ictseoyoungmin/HADARA#readme",
  "bugs": {
    "url": "https://github.com/ictseoyoungmin/HADARA/issues"
  },
  "bin": {
    "hadara": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/main.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:focused": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:harness": "vitest run tests/harness",
    "check": "npm run build && npm test",
    "dev:docker-check": "bash scripts/dev-docker-sync-build.sh --check-only --no-smoke",
    "dev:docker-sync-build": "bash scripts/dev-docker-sync-build.sh",
    "dashboard:build": "node dashboard/build.mjs",
    "dashboard:build:docker": "bash scripts/dashboard-build.sh",
    "dashboard:visual:docker": "bash scripts/dashboard-visual-check.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "preact": "^10.29.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
