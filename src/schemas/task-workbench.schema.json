{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.task.workbench.v1",
  "x-hadara-schema-id": "hadara.task.workbench.v1",
  "x-hadara-field-classes": {
      "stable": [
      "schemaVersion",
      "command",
      "ok",
      "task.id",
      "task.taskStatus",
      "task.taskBoardStatus",
      "task.taskBoardPath",
      "task.taskBoardPresent",
      "state.closeState",
      "state.ready",
      "state.closeEvidenceFound",
      "state.closedValid",
      "summary.blockers",
        "summary.warnings",
        "loop.phase",
        "loop.primaryNextAction",
        "issues",
        "nextActions"
    ],
    "compatibilityAlias": [
      {
        "field": "state.closed",
        "preferred": "state.closedValid",
        "notes": "Kept for existing task.status consumers; new consumers should read state.closeState and state.closedValid."
      }
    ],
    "additive": [
      "state.readiness",
      "sources.*",
      "sources.evidenceList.validationAttempts",
      "authoringGuidance",
      "authoringSuggestions",
      "diagnostics",
      "loop",
      "nextActions.*"
    ],
    "experimental": [
      "generatedAt"
    ],
    "deprecated": []
  },
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "command", "ok", "generatedAt", "projectRoot", "task", "state", "summary", "loop", "sources", "issues", "nextActions"],
  "properties": {
    "schemaVersion": { "const": "hadara.task.workbench.v1" },
    "command": { "const": "task.status" },
    "ok": { "type": "boolean" },
    "generatedAt": { "type": "string" },
    "projectRoot": { "type": "string" },
    "task": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "capsule", "taskStatus", "taskBoardStatus", "taskBoardPath", "taskBoardPresent"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "capsule": { "type": "string" },
        "taskStatus": { "type": "string" },
        "taskBoardStatus": { "type": "string" },
        "taskBoardPath": { "type": "string" },
        "taskBoardPresent": { "type": "boolean" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["closeState", "ready", "closeEvidenceFound", "closedValid", "closed", "auditable"],
      "properties": {
        "closeState": { "enum": ["not-closed", "closed", "closed-valid", "close-evidence-found-invalid", "close-evidence-malformed"] },
        "ready": { "type": "boolean" },
        "readiness": {
          "type": "object",
          "additionalProperties": true,
          "required": ["status", "currentReady", "closeProofValid", "summary"],
          "properties": {
            "status": { "enum": ["ready", "current-blocked", "closed-valid-current-blocked", "missing-task"] },
            "currentReady": { "type": "boolean" },
            "closeProofValid": { "type": "boolean" },
            "summary": { "type": "string" }
          }
        },
        "closeEvidenceFound": { "type": "boolean" },
        "closedValid": { "type": "boolean" },
        "closed": { "type": "boolean" },
        "auditable": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["blockers", "warnings", "evidenceRecords", "nextActions"],
      "properties": {
        "blockers": { "type": "number" },
        "warnings": { "type": "number" },
        "evidenceRecords": { "type": "number" },
        "nextActions": { "type": "number" }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": true,
      "required": ["phase", "summary", "statusCommand", "deprecatedCommands"],
      "properties": {
        "phase": { "enum": ["select-work", "author-task", "implement", "validate-evidence", "finalize-dry-run", "finalize-execute", "closed-valid", "blocked"] },
        "summary": { "type": "string" },
        "statusCommand": { "type": "string" },
        "primaryNextAction": { "type": "object", "additionalProperties": true },
        "deprecatedCommands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["command", "replacement", "removal", "note"],
            "properties": {
              "command": { "type": "string" },
              "replacement": { "type": "string" },
              "removal": { "const": "planned" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": true,
      "required": ["taskClosePlan", "evidenceLint", "evidenceList", "protocolTask", "protocolDocs", "protocolProfile"],
      "properties": {
        "taskClosePlan": { "type": "object", "additionalProperties": true },
        "evidenceLint": { "type": "object", "additionalProperties": true },
        "evidenceList": { "type": "object", "additionalProperties": true },
        "protocolTask": { "type": "object", "additionalProperties": true },
        "protocolDocs": { "type": "object", "additionalProperties": true },
        "protocolProfile": { "type": "object", "additionalProperties": true }
      }
    },
    "issues": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "authoringGuidance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["readOnly", "writesProse", "status", "summary", "items"],
      "properties": {
        "readOnly": { "const": true },
        "writesProse": { "const": false },
        "status": { "enum": ["needs-authoring", "current", "task-missing"] },
        "summary": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generatedBy", "commandPath", "durationMs", "slowThresholdMs", "slow"],
      "properties": {
        "generatedBy": { "const": "cli" },
        "commandPath": { "type": "string" },
        "durationMs": { "type": "number" },
        "slowThresholdMs": { "type": "number" },
        "slow": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "authoringSuggestions": {
      "type": "object",
      "additionalProperties": true,
      "required": ["readOnly", "writesProse", "status", "title", "sourceDocuments", "acceptance"],
      "properties": {
        "readOnly": { "const": true },
        "writesProse": { "const": false },
        "status": { "enum": ["none", "suggested"] },
        "title": { "type": "object", "additionalProperties": true },
        "sourceDocuments": { "type": "object", "additionalProperties": true },
        "acceptance": { "type": "object", "additionalProperties": true }
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "kind", "required", "priority", "message", "sourceIssueCodes"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["command", "review", "edit", "remediation", "audit", "continue"] },
          "required": { "type": "boolean" },
          "priority": { "enum": ["now", "soon", "optional"] },
          "command": { "type": "string" },
          "executeCommand": { "type": "string" },
          "message": { "type": "string" },
          "path": { "type": "string" },
          "sourceIssueCodes": { "type": "array", "items": { "type": "string" } },
          "loopBoundary": { "type": "boolean" }
        }
      }
    }
  }
}
