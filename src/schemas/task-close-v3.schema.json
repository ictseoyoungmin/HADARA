{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.task.close.v3",
  "x-hadara-schema-id": "hadara.task.close.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "ok", "mode", "taskId", "generatedAt", "actor", "closeState", "planStatus", "terminal", "operatorGuidance", "readOnly", "transaction", "writeSummary", "source", "nextActions", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.task.close.v3" },
    "command": { "const": "task.close" },
    "ok": { "type": "boolean" },
    "mode": { "enum": ["dry-run", "execute", "execute-refused"] },
    "taskId": { "type": "string" },
    "generatedAt": { "type": "string" },
    "actor": { "type": "object", "additionalProperties": true },
    "closeState": { "enum": ["blocked", "ready-to-close", "closed-valid", "closed-stale", "in-progress"] },
    "planStatus": { "enum": ["blocked", "executable", "executable-with-deferred-checks", "satisfied", "pending"] },
    "terminal": { "type": "boolean" },
    "operatorGuidance": { "type": "string", "minLength": 1 },
    "readOnly": { "type": "boolean" },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "internalReview", "planHash", "proofLast", "stalePlanGuard", "lockOrder", "locks", "markerPersistence"],
      "properties": {
        "strategy": { "enum": ["close-auto", "close-reviewed-plan", "review-only"] },
        "internalReview": { "type": "boolean" },
        "planHash": { "type": "string" },
        "proofLast": { "const": true },
        "stalePlanGuard": { "const": true },
        "lockOrder": {
          "type": "array",
          "items": { "type": "string" },
          "prefixItems": [
            { "const": "project-lifecycle" },
            { "const": "task-board" },
            { "const": "task-scoped" },
            { "const": "evidence-append" }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "locks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "path", "waitedMs", "contended", "timeoutMs"],
            "properties": {
              "name": { "enum": ["project-lifecycle", "task-board", "task-scoped"] },
              "path": { "type": "string" },
              "waitedMs": { "type": "number" },
              "contended": { "type": "boolean" },
              "timeoutMs": { "type": "number" }
            }
          }
        },
        "markerPersistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contentWrites", "cleanupWrites", "progressWrites", "fileFsyncs", "directoryFsyncs", "unchangedSkips"],
          "properties": {
            "contentWrites": { "type": "integer", "minimum": 0 },
            "cleanupWrites": { "type": "integer", "minimum": 0 },
            "progressWrites": { "type": "integer", "minimum": 0 },
            "fileFsyncs": { "type": "integer", "minimum": 0 },
            "directoryFsyncs": { "type": "integer", "minimum": 0 },
            "unchangedSkips": { "type": "integer", "minimum": 0 }
          }
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId", "taskId", "idempotencyKey", "intendedFinalState", "phase", "closeSourceHash", "planHash", "writeSetHash", "expectedWrites", "completedSteps", "pendingSteps", "path", "persisted", "createdAt", "updatedAt"],
          "properties": {
            "operationId": { "type": "string" },
            "taskId": { "type": "string" },
            "idempotencyKey": { "type": "string" },
            "intendedFinalState": { "const": "closed-valid" },
            "phase": { "enum": ["planned", "applying", "verifying", "proof-pending", "closed-valid", "blocked", "recovery-required"] },
            "closeSourceHash": { "type": "string" },
            "planFingerprint": { "type": "string" },
            "planHash": { "type": "string" },
            "writeSetHash": { "type": "string" },
            "expectedWrites": {
              "type": "array",
              "items": { "$ref": "#/$defs/expectedWrite" }
            },
            "completedSteps": { "type": "array", "items": { "type": "string" } },
            "pendingSteps": { "type": "array", "items": { "type": "string" } },
            "stepJournal": {
              "type": "array",
              "items": { "$ref": "#/$defs/operationJournalEntry" }
            },
            "mutationSummary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["executedWrites", "closeProofAppended", "idempotentNoop"],
              "properties": {
                "executedWrites": { "type": "integer", "minimum": 0 },
                "plannedMutationSteps": { "type": "integer", "minimum": 0 },
                "executedMutationSteps": { "type": "integer", "minimum": 0 },
                "plannedFileWrites": { "type": "integer", "minimum": 0 },
                "executedFileWrites": { "type": "integer", "minimum": 0 },
                "evidenceAppends": { "type": "integer", "minimum": 0 },
                "recoveredWrites": { "type": "integer", "minimum": 0 },
                "closeProofAppended": { "type": "boolean" },
                "idempotentNoop": { "type": "boolean" }
              }
            },
            "attempts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["attemptNumber", "startedAt", "phase", "stepJournal", "mutationSummary"],
                "properties": {
                  "attemptNumber": { "type": "integer", "minimum": 1 },
                  "startedAt": { "type": "string" },
                  "completedAt": { "type": "string" },
                  "phase": { "enum": ["planned", "applying", "verifying", "proof-pending", "closed-valid", "blocked", "recovery-required"] },
                  "stepJournal": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/operationJournalEntry" }
                  },
                  "mutationSummary": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["executedWrites", "closeProofAppended", "idempotentNoop"],
                    "properties": {
                      "executedWrites": { "type": "integer", "minimum": 0 },
                      "plannedMutationSteps": { "type": "integer", "minimum": 0 },
                      "executedMutationSteps": { "type": "integer", "minimum": 0 },
                      "plannedFileWrites": { "type": "integer", "minimum": 0 },
                      "executedFileWrites": { "type": "integer", "minimum": 0 },
                      "evidenceAppends": { "type": "integer", "minimum": 0 },
                      "recoveredWrites": { "type": "integer", "minimum": 0 },
                      "closeProofAppended": { "type": "boolean" },
                      "idempotentNoop": { "type": "boolean" }
                    }
                  }
                }
              }
            },
            "path": { "type": "string" },
            "persisted": { "type": "boolean" },
            "resumedFromOperation": { "type": "boolean" },
            "finalSourceHash": { "type": "string" },
            "proof": {
              "type": "object",
              "additionalProperties": false,
              "required": ["idempotencyKey", "outcome"],
              "properties": {
                "idempotencyKey": { "type": "string" },
                "outcome": { "enum": ["pending", "appended", "existing-noop"] }
              }
            },
            "createdAt": { "type": "string" },
            "updatedAt": { "type": "string" }
          }
        }
      }
    },
    "writeSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["plannedWrites", "executedWrites", "plannedMutationSteps", "executedMutationSteps", "plannedFileWrites", "executedFileWrites", "evidenceAppends", "executedSteps", "closeProofAppended", "idempotentNoop"],
  "properties": {
        "plannedWrites": { "type": "integer", "minimum": 0 },
        "executedWrites": { "type": "integer", "minimum": 0 },
        "plannedMutationSteps": { "type": "integer", "minimum": 0 },
        "executedMutationSteps": { "type": "integer", "minimum": 0 },
        "plannedFileWrites": { "type": "integer", "minimum": 0 },
        "executedFileWrites": { "type": "integer", "minimum": 0 },
        "evidenceAppends": { "type": "integer", "minimum": 0 },
        "executedSteps": { "type": "array", "items": { "type": "string" } },
        "stoppedAt": { "type": "string" },
        "closeProofAppended": { "type": "boolean" },
        "idempotentNoop": { "type": "boolean" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "action"],
      "properties": {
        "required": { "type": "boolean" },
        "operationId": { "type": "string" },
        "phase": { "enum": ["planned", "applying", "verifying", "proof-pending", "closed-valid", "blocked", "recovery-required"] },
        "resumable": { "type": "boolean" },
        "completedWrites": {
          "type": "array",
          "items": { "$ref": "#/$defs/recoveryWrite" }
        },
        "pendingWrites": {
          "type": "array",
          "items": { "$ref": "#/$defs/recoveryWrite" }
        },
        "conflictingWrites": {
          "type": "array",
          "items": { "$ref": "#/$defs/recoveryWrite" }
        },
        "primaryAction": { "type": "object", "additionalProperties": true },
        "action": { "type": "object", "additionalProperties": true }
      }
    },
    "primaryNextAction": { "type": "object", "additionalProperties": true },
    "nextActions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["closePlan"],
      "properties": {
        "closePlan": { "type": "object", "additionalProperties": true }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generatedBy", "commandPath", "durationMs", "slowThresholdMs", "slow"],
      "properties": {
        "generatedBy": { "const": "cli" },
        "commandPath": { "type": "string" },
        "durationMs": { "type": "number" },
        "slowThresholdMs": { "type": "number" },
        "slow": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["error", "warning", "info"] },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "path": { "type": "string" },
          "fixHint": { "type": "string" },
          "example": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "expectedWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "path", "writeBoundary"],
      "allOf": [
        {
          "if": {
            "properties": { "writeBoundary": { "const": "task-local" } },
            "required": ["writeBoundary"]
          },
          "then": {
            "required": ["expectedBeforeExists", "expectedBeforeHash", "afterHash"]
          }
        },
        {
          "if": {
            "properties": { "writeBoundary": { "const": "evidence-append" } },
            "required": ["writeBoundary"]
          },
          "then": {
            "required": ["appendKind", "appendOrder", "idempotencyKey", "recordHash"]
          }
        }
      ],
      "properties": {
        "step": { "enum": ["bookkeeping", "ready", "close", "audit-close"] },
        "path": { "type": "string" },
        "writeBoundary": { "enum": ["task-local", "evidence-append"] },
        "action": { "enum": ["update", "insert"] },
        "field": { "enum": ["task-status", "task-handoff-identity", "task-board-row", "current-state", "project-state-projection", "handoff-projection"] },
        "expectedBeforeExists": { "type": "boolean" },
        "expectedBeforeHash": { "type": "string" },
        "afterHash": { "type": "string" },
        "appendKind": { "enum": ["readiness-evidence", "close-proof"] },
        "appendOrder": { "type": "integer", "minimum": 1 },
        "idempotencyKey": { "type": "string" },
        "recordHash": { "type": "string" }
      }
    },
    "operationJournalEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "step", "phase", "status", "writeBoundary", "mutated", "at"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "step": { "enum": ["bookkeeping", "ready", "close", "audit-close"] },
        "phase": { "enum": ["intent", "outcome"] },
        "status": { "enum": ["start", "executed", "satisfied", "blocked", "skipped"] },
        "writeBoundary": { "enum": ["read-only", "task-local", "evidence-append"] },
        "writeOutcome": { "enum": ["appended", "existing-noop", "blocked"] },
        "mutated": { "type": "boolean" },
        "fileWrites": { "type": "integer", "minimum": 0 },
        "at": { "type": "string" }
      }
    },
    "recoveryWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "path", "writeBoundary", "status", "sequence"],
      "properties": {
        "step": { "enum": ["bookkeeping", "ready", "close", "audit-close"] },
        "path": { "type": "string" },
        "writeBoundary": { "enum": ["task-local", "evidence-append"] },
        "status": { "enum": ["before", "after", "conflict", "missing-conflict", "pending"] },
        "sequence": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
