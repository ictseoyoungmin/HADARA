{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.dashboard.core.v1",
  "x-hadara-schema-id": "hadara.dashboard.core.v1",
  "type": "object",
  "required": ["schemaVersion", "command", "ok", "generatedAt", "source", "projection", "core", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.dashboard.core.v1" },
    "command": { "const": "dashboard.core" },
    "ok": { "type": "boolean" },
    "generatedAt": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["kind", "label", "projectRootRedacted", "project"],
      "properties": {
        "kind": { "enum": ["projection", "live-api"] },
        "label": { "type": "string" },
        "projectRootRedacted": { "const": true },
        "project": {
          "type": "object",
          "required": ["kind", "pathRedacted", "fingerprint"],
          "properties": {
            "kind": { "const": "project-root" },
            "pathRedacted": { "const": true },
            "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{12}$" }
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "required": ["freshness", "completeness", "refreshState", "generatedAt", "pendingSections", "staleSections", "sourceSignals"],
      "properties": {
        "freshness": { "enum": ["fresh", "stale", "missing", "unknown"] },
        "completeness": { "enum": ["core", "partial", "complete"] },
        "refreshState": { "enum": ["idle", "checking", "refreshing", "failed"] },
        "generatedAt": { "type": ["string", "null"] },
        "pendingSections": {
          "type": "array",
          "items": { "type": "string" }
        },
        "staleSections": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sourceSignals": {
          "type": "object",
          "properties": {
            "taskBoard": { "enum": ["known", "checking", "changed", "missing", "unknown"] },
            "handoff": { "enum": ["known", "checking", "changed", "missing", "unknown"] },
            "projectState": { "enum": ["known", "checking", "changed", "missing", "unknown"] },
            "capsules": { "enum": ["known", "checking", "changed", "missing", "unknown"] },
            "debt": { "enum": ["known", "checking", "changed", "missing", "unknown"] }
          }
        }
      }
    },
    "core": {
      "type": "object",
      "required": ["health", "taskSummary", "handoffSummary"],
      "properties": {
        "health": { "enum": ["ok", "degraded", "error", "unknown"] },
        "taskSummary": {
          "type": "object",
          "required": ["total", "counts", "lastCompleted", "nextRecommended", "recent"],
          "properties": {
            "total": { "type": "number" },
            "counts": { "type": "object" },
            "lastCompleted": { "type": "array" },
            "nextRecommended": { "type": ["string", "null"] },
            "recent": { "type": "array" }
          }
        },
        "handoffSummary": {
          "type": "object",
          "required": ["currentState", "knownProblems", "nextRecommendedStep"],
          "properties": {
            "currentState": { "type": "array" },
            "knownProblems": { "type": "array" },
            "nextRecommendedStep": { "type": "array" }
          }
        },
        "activeRunSummary": { "type": "object" },
        "validationSummary": { "type": "object" },
        "debtSummary": { "type": "object" }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["warning", "error"] },
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
