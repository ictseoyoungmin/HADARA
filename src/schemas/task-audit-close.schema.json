{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.task.audit_close.v1",
  "x-hadara-schema-id": "hadara.task.audit_close.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "command", "ok", "taskId", "projectRoot", "actor", "summary", "currentValidationReportHash", "currentSourceHash", "nextActions", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.task.audit_close.v1" },
    "command": { "const": "task.audit-close" },
    "ok": { "type": "boolean" },
    "taskId": { "type": "string" },
    "projectRoot": { "type": "string" },
    "actor": {
      "type": "object",
      "additionalProperties": true,
      "required": ["agentId", "runId", "role", "parentRunId"],
      "properties": {
        "agentId": { "type": "string" },
        "runId": { "type": "string" },
        "role": { "enum": ["operator", "coordinator", "worker", "reviewer", "unknown"] },
        "parentRunId": { "type": ["string", "null"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["closeEvidenceRecords", "blockers", "warnings"],
      "properties": {
        "closeEvidenceRecords": { "type": "number" },
        "blockers": { "type": "number" },
        "warnings": { "type": "number" }
      }
    },
    "currentValidationReportHash": { "type": "string" },
    "currentSourceHash": { "type": "string" },
    "latestCloseEvidence": { "type": "object", "additionalProperties": true },
    "auditVerdict": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "phase": { "const": "post-close-audit" },
        "verdict": { "enum": ["closed-valid", "not-closed", "close-evidence-invalid", "closed-with-drift-warnings"] },
        "closeEvidenceFound": { "type": "boolean" },
        "closeEvidenceValid": { "type": "boolean" },
        "reportHashMatches": { "type": "boolean" },
        "sourceHashMatches": { "type": "boolean" },
        "writeBoundary": { "const": "read-only" },
        "model": { "const": "validation-close-audit" }
      }
    },
    "closeEvidenceAudit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["supersededCloseEvidenceIds", "duplicateCloseEvidenceCount", "verdict"],
      "properties": {
        "latestCloseEvidenceId": { "type": "string" },
        "supersededCloseEvidenceIds": { "type": "array", "items": { "type": "string" } },
        "duplicateCloseEvidenceCount": { "type": "number" },
        "verdict": { "enum": ["valid", "not-closed", "duplicate-warning", "stale", "unknown"] }
      }
    },
    "nextActions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "primaryNextAction": { "type": "object", "additionalProperties": true },
    "issues": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  }
}
