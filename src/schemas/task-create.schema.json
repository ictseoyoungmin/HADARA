{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.task.create.v1",
  "x-hadara-schema-id": "hadara.task.create.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "command", "ok", "supportedTemplates", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.task.create.v1" },
    "command": { "const": "task.create" },
    "ok": { "type": "boolean" },
    "task": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "capsule"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "capsule": { "type": "string" }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "applied", "recommendedActorRole", "expectedEvidence", "outOfScope"],
      "properties": {
        "id": { "type": "string" },
        "applied": { "type": "boolean" },
        "recommendedActorRole": { "enum": ["operator", "coordinator", "worker", "reviewer", "unknown"] },
        "expectedEvidence": { "type": "array", "items": { "type": "string" } },
        "outOfScope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "supportedTemplates": { "type": "array", "items": { "type": "string" } },
    "issues": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  }
}
