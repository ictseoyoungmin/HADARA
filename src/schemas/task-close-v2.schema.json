{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.task.close.v2",
  "x-hadara-schema-id": "hadara.task.close.v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "command", "ok", "mode", "taskId", "generatedAt", "actor", "closeState", "planStatus", "readOnly", "transaction", "writeSummary", "source", "nextActions", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.task.close.v2" },
    "command": { "const": "task.close" },
    "ok": { "type": "boolean" },
    "mode": { "enum": ["dry-run", "execute", "execute-refused"] },
    "taskId": { "type": "string" },
    "generatedAt": { "type": "string" },
    "actor": { "type": "object", "additionalProperties": true },
    "closeState": { "enum": ["blocked", "ready-to-close", "closed-valid", "closed-stale", "in-progress"] },
    "planStatus": { "enum": ["blocked", "executable", "executable-with-deferred-checks", "satisfied", "pending"] },
    "readOnly": { "type": "boolean" },
    "transaction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["strategy", "internalReview", "planHash", "proofLast", "stalePlanGuard"],
      "properties": {
        "strategy": { "enum": ["finalize-auto", "finalize-reviewed-plan", "review-only"] },
        "internalReview": { "type": "boolean" },
        "planHash": { "type": "string" },
        "proofLast": { "const": true },
        "stalePlanGuard": { "const": true }
      }
    },
    "writeSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["plannedWrites", "executedWrites", "executedSteps", "closeProofAppended", "idempotentNoop"],
      "properties": {
        "plannedWrites": { "type": "number" },
        "executedWrites": { "type": "number" },
        "executedSteps": { "type": "array", "items": { "type": "string" } },
        "stoppedAt": { "type": "string" },
        "closeProofAppended": { "type": "boolean" },
        "idempotentNoop": { "type": "boolean" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": true,
      "required": ["required", "action"],
      "properties": {
        "required": { "type": "boolean" },
        "action": { "type": "object", "additionalProperties": true }
      }
    },
    "primaryNextAction": { "type": "object", "additionalProperties": true },
    "nextActions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["finalize"],
      "properties": {
        "finalize": { "type": "object", "additionalProperties": true }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generatedBy", "commandPath", "durationMs", "slowThresholdMs", "slow"],
      "properties": {
        "generatedBy": { "const": "cli" },
        "commandPath": { "type": "string" },
        "durationMs": { "type": "number" },
        "slowThresholdMs": { "type": "number" },
        "slow": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["error", "warning", "info"] },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "path": { "type": "string" },
          "fixHint": { "type": "string" },
          "example": { "type": "string" }
        }
      }
    }
  }
}
