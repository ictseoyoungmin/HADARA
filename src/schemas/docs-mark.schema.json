{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.docs.mark.v1",
  "x-hadara-schema-id": "hadara.docs.mark.v1",
  "title": "HADARA Docs Mark Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "command", "mode", "ok", "path", "correction", "beforeStatus", "afterStatus", "fieldDiff", "reason", "registryPath", "beforeHash", "impact", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.docs.mark.v1" },
    "command": { "const": "docs.mark" },
    "mode": { "type": "string", "enum": ["dry-run", "execute"] },
    "ok": { "type": "boolean" },
    "path": { "type": "string", "minLength": 1 },
    "correction": { "type": "boolean" },
    "beforeStatus": {
      "oneOf": [
        { "type": "string", "enum": ["canonical", "active", "reference", "historical", "superseded", "archived"] },
        { "type": "null" }
      ]
    },
    "fieldDiff": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "before", "after"],
        "properties": {
          "field": { "type": "string", "enum": ["status", "supersededBy"] },
          "before": {
            "oneOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "after": {
            "oneOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "afterStatus": {
      "oneOf": [
        { "type": "string", "enum": ["canonical", "active", "reference", "historical", "superseded", "archived"] },
        { "type": "null" }
      ]
    },
    "supersededBy": { "type": "string", "minLength": 1 },
    "reason": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "registryPath": { "const": ".hadara/docs-registry.json" },
    "beforeHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "impact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["registryPatchPlanned", "defaultRequiredReading", "managedRequiredReadingPatchAvailable", "archiveCandidate"],
      "properties": {
        "registryPatchPlanned": { "type": "boolean" },
        "defaultRequiredReading": { "type": "string", "enum": ["unchanged", "remove-after-execute", "excluded"] },
        "managedRequiredReadingPatchAvailable": { "type": "boolean" },
        "archiveCandidate": { "type": "boolean" }
      }
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": true,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "type": "string", "enum": ["warning", "error"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
