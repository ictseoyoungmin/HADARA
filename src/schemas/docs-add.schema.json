{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.docs.add.v1",
  "x-hadara-schema-id": "hadara.docs.add.v1",
  "title": "HADARA Docs Add Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "command", "ok", "mode", "type", "path", "beforeHash", "action", "writes", "document", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.docs.add.v1" },
    "command": { "const": "docs.add" },
    "ok": { "type": "boolean" },
    "mode": { "type": "string", "enum": ["dry-run", "execute"] },
    "type": {
      "oneOf": [
        { "type": "string", "enum": ["architecture", "decisions", "roadmap", "security-model", "agent-guide"] },
        { "type": "null" }
      ]
    },
    "path": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "beforeHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "action": { "type": "string", "enum": ["create", "register-existing", "already-current", "blocked"] },
    "writes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "document": {
      "oneOf": [
        { "$ref": "#/$defs/document" },
        { "type": "null" }
      ]
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "executeCommand": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "title", "owner", "kind", "status", "profiles", "readWhen", "requiredReading", "origin"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "profiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "readWhen": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredReading": { "type": "boolean" },
        "origin": {
          "type": "object",
          "additionalProperties": true,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "generator": { "type": "string", "minLength": 1 },
            "template": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": true,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "type": "string", "enum": ["warning", "error"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "received": { "type": "string" },
        "allowedValues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
