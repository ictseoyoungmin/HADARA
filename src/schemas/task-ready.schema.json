{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.task.ready.v1",
  "x-hadara-schema-id": "hadara.task.ready.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "command", "ok", "taskId", "projectRoot", "actor", "level", "summary", "checks", "nextActions", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.task.ready.v1" },
    "command": { "const": "task.ready" },
    "ok": { "type": "boolean" },
    "taskId": { "type": "string" },
    "projectRoot": { "type": "string" },
    "actor": {
      "type": "object",
      "additionalProperties": true,
      "required": ["agentId", "runId", "role", "parentRunId"],
      "properties": {
        "agentId": { "type": "string" },
        "runId": { "type": "string" },
        "role": { "enum": ["operator", "coordinator", "worker", "reviewer", "unknown"] },
        "parentRunId": { "type": ["string", "null"] }
      }
    },
    "level": { "const": "done" },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ready", "blockers", "warnings"],
      "properties": {
        "ready": { "type": "boolean" },
        "blockers": { "type": "number" },
        "warnings": { "type": "number" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": true,
      "required": ["doneValidation", "evidenceLint", "protocolDoctor"],
      "properties": {
        "doneValidation": { "type": "boolean" },
        "evidenceLint": { "type": "boolean" },
        "protocolDoctor": { "type": "boolean" }
      }
    },
    "nextActions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "primaryNextAction": { "type": "object", "additionalProperties": true },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": true,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["error", "warning", "info"] },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "path": { "type": "string" },
        "heading": { "type": "string" },
        "fixHint": { "type": "string" },
        "example": { "type": "string" },
        "remediationHint": { "$ref": "#/$defs/remediationHint" }
      }
    },
    "remediationHint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "requiredChange", "blocking"],
      "properties": {
        "path": { "type": "string" },
        "heading": { "type": "string" },
        "requiredChange": { "type": "string" },
        "example": { "type": "string" },
        "blocking": { "type": "boolean" }
      }
    }
  }
}
