{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.project.status.v2",
  "x-hadara-schema-id": "hadara.project.status.v2",
  "title": "HADARA Project Status v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "command", "ok", "scope", "generatedAt", "projectRoot", "phase", "health", "readiness", "evaluations", "primaryNextAction", "compatibility", "sources", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.project.status.v2" },
    "command": { "const": "status" },
    "ok": { "type": "boolean" },
    "scope": { "const": "project" },
    "generatedAt": { "type": "string" },
    "projectRoot": { "type": "string" },
    "phase": {
      "enum": ["uninitialized", "adoption-review", "upgrade-required", "select-work", "active-work", "release-preparation", "integration-setup", "idle", "degraded"]
    },
    "health": { "enum": ["ok", "attention", "blocked", "degraded", "unknown"] },
    "readiness": {
      "type": "object",
      "additionalProperties": true,
      "required": ["intent", "status", "reason"],
      "properties": {
        "intent": { "enum": ["orient", "plan", "edit", "validate", "close", "release"] },
        "status": { "enum": ["ready", "needs-context", "needs-review", "not-evaluated", "blocked", "terminal"] },
        "reason": { "type": "string" }
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "state", "health", "summary"],
        "properties": {
          "id": { "type": "string" },
          "state": { "enum": ["evaluated", "not-evaluated", "unavailable", "stale", "invalid", "partial"] },
          "health": { "enum": ["ok", "attention", "blocked", "degraded", "unknown"] },
          "summary": { "type": "string" }
        }
      }
    },
    "primaryNextAction": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["id", "kind", "message", "writeBoundary", "risk", "requiresReview", "writes"],
          "properties": {
            "id": { "type": "string" },
            "kind": { "enum": ["command", "review", "create", "none"] },
            "command": { "type": "string" },
            "message": { "type": "string" },
            "writeBoundary": { "enum": ["read-only", "task-local", "project-state", "evidence-append", "task-close-transaction", "none"] },
            "risk": { "enum": ["none", "low", "medium", "high"] },
            "requiresReview": { "type": "boolean" },
            "writes": { "type": "boolean" }
          }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": true,
      "required": ["legacySchemaVersion", "legacyCommand", "migration"],
      "properties": {
        "legacySchemaVersion": { "const": "hadara.ops.status.v1" },
        "legacyCommand": { "type": "string" },
        "migration": { "type": "string" }
      }
    },
    "sources": { "type": "object" },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["error", "warning"] },
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
