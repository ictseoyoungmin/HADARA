{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.plan_context.v1",
  "x-hadara-schema-id": "hadara.plan_context.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "generatedAt", "affectedFiles", "reviewed"],
  "properties": {
    "schemaVersion": { "const": "hadara.plan_context.v1" },
    "planId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "affectedFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "beforeHash": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "reviewed": { "const": false }
  }
}
