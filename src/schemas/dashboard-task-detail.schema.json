{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.dashboard.task_detail.v1",
  "x-hadara-schema-id": "hadara.dashboard.task_detail.v1",
  "type": "object",
  "required": ["schemaVersion", "command", "ok", "taskId", "generatedAt", "source", "workbench", "evidenceLint", "evidenceList", "timeline", "proof", "commandGuidance", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.dashboard.task_detail.v1" },
    "command": { "const": "dashboard.task-detail" },
    "ok": { "type": "boolean" },
    "taskId": { "type": "string" },
    "generatedAt": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["kind", "projectRoot", "readOnly"],
      "properties": {
        "kind": { "const": "live-api" },
        "projectRoot": { "type": "string" },
        "readOnly": { "const": true }
      }
    },
    "workbench": { "type": "object" },
    "evidenceLint": { "type": "object" },
    "evidenceList": { "type": "object" },
    "timeline": { "type": "object" },
    "proof": {
      "type": "object",
      "required": ["status", "blocking", "auditabilityWarning", "note", "substantivePositive", "semanticIssueCodes"],
      "properties": {
        "status": { "enum": ["sufficient", "weak", "failed", "blocked", "private-only", "unknown"] },
        "blocking": { "type": "boolean" },
        "auditabilityWarning": { "type": "boolean" },
        "note": { "type": "string" },
        "substantivePositive": { "type": "number" },
        "semanticIssueCodes": { "type": "array" }
      }
    },
    "commandGuidance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "command", "readOnly"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "command": { "type": ["string", "null"] },
          "readOnly": { "const": true }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["warning", "error"] },
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
