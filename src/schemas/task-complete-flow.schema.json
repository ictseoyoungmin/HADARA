{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.task.complete_flow.v1",
  "x-hadara-schema-id": "hadara.task.complete_flow.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "command", "ok", "readOnly", "taskId", "generatedAt", "actor", "stage", "nextActions", "steps", "conflicts", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.task.complete_flow.v1" },
    "command": { "const": "task.complete" },
    "ok": { "type": "boolean" },
    "readOnly": { "const": true },
    "taskId": { "type": "string" },
    "generatedAt": { "type": "string" },
    "actor": {
      "type": "object",
      "additionalProperties": true,
      "required": ["agentId", "runId", "role", "parentRunId"],
      "properties": {
        "agentId": { "type": "string" },
        "runId": { "type": "string" },
        "role": { "enum": ["operator", "coordinator", "worker", "reviewer", "unknown"] },
        "parentRunId": { "type": ["string", "null"] }
      }
    },
    "stage": {
      "enum": [
        "evidence-required",
        "finish-required",
        "ready-required",
        "close-required",
        "audit-required",
        "handoff-update-suggested",
        "complete",
        "blocked",
        "unknown"
      ]
    },
    "primaryNextAction": { "type": "object", "additionalProperties": true },
    "nextActions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "status", "summary"],
        "properties": {
          "id": { "enum": ["evidence", "finish", "ready", "close", "audit-close", "handoff"] },
          "status": { "enum": ["passed", "required", "pending", "blocked", "warning", "skipped", "unknown"] },
          "summary": { "type": "string" },
          "sourceReport": { "type": "string" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["code", "severity", "summary"],
        "properties": {
          "code": { "enum": ["CONCURRENT_TASK_ACTIVITY", "STALE_PLAN", "SHARED_DOC_PENDING", "CLOSE_EVIDENCE_DUPLICATE", "UNKNOWN"] },
          "severity": { "enum": ["warning", "error"] },
          "summary": { "type": "string" }
        }
      }
    },
    "stateDocs": {
      "type": "object",
      "additionalProperties": true,
      "required": ["pending", "missing", "current", "recommendedActorRole"],
      "properties": {
        "pending": { "type": "number" },
        "missing": { "type": "number" },
        "current": { "type": "number" },
        "recommendedActorRole": { "const": "coordinator" }
      }
    },
    "issues": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  }
}
