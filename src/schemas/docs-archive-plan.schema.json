{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.docs.archivePlan.v1",
  "x-hadara-schema-id": "hadara.docs.archivePlan.v1",
  "title": "HADARA Docs Archive Plan Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "command", "mode", "ok", "filters", "candidates", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.docs.archivePlan.v1" },
    "command": { "const": "docs.archive" },
    "mode": { "const": "dry-run" },
    "ok": { "type": "boolean" },
    "filters": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {
          "oneOf": [
            { "type": "string", "enum": ["canonical", "active", "reference", "historical", "superseded", "archived"] },
            { "type": "null" }
          ]
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "currentStatus", "suggestedArchivePath", "referencedByActiveDocs", "referencedByTaskEvidence", "risk", "executeSupported"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "currentStatus": { "type": "string", "enum": ["historical", "superseded"] },
        "suggestedArchivePath": { "type": "string", "minLength": 1 },
        "referencedByActiveDocs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "referencedByTaskEvidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "risk": { "type": "string", "enum": ["low", "active-doc-reference", "evidence-link-reference"] },
        "executeSupported": { "const": false }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": true,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "type": "string", "enum": ["warning", "error"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
