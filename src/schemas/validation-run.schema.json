{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.validation.run.v1",
  "x-hadara-schema-id": "hadara.validation.run.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "command", "ok", "taskId", "check", "cwd", "argv", "execution", "result", "attempt", "taskValidationRow", "acceptanceRows", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.validation.run.v1" },
    "command": { "const": "validation.run" },
    "ok": { "type": "boolean" },
    "taskId": { "type": "string" },
    "check": { "type": "string" },
    "cwd": { "type": "string" },
    "argv": { "type": "array", "items": { "type": "string" } },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["exitCode", "signal", "timedOut", "durationMs", "stdoutHash", "stderrHash"],
      "properties": {
        "exitCode": { "type": ["number", "null"] },
        "signal": { "type": ["string", "null"] },
        "timedOut": { "type": "boolean" },
        "durationMs": { "type": "number" },
        "stdoutHash": { "type": "string" },
        "stderrHash": { "type": "string" },
        "commandStarted": { "type": "boolean" },
        "failureKind": { "enum": ["none", "non-zero-exit", "timeout", "permission-denied", "command-not-found", "launch-error"] },
        "error": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "code": { "type": ["string", "null"] },
            "message": { "type": "string" },
            "syscall": { "type": "string" },
            "path": { "type": "string" }
          }
        }
      }
    },
    "result": { "enum": ["Passed", "Failed", "Blocked"] },
    "attempt": {
      "type": "object",
      "additionalProperties": true,
      "required": ["checkKey", "previousFailedOrBlockedEvidenceIds", "autoResolvedEvidenceIds"],
      "properties": {
        "checkKey": { "type": "string" },
        "previousFailedOrBlockedEvidenceIds": { "type": "array", "items": { "type": "string" } },
        "autoResolvedEvidenceIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": { "type": "object", "additionalProperties": true },
    "taskValidationRow": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "updated", "appended"],
      "properties": {
        "mode": { "enum": ["skipped", "updated"] },
        "updated": { "type": "boolean" },
        "appended": { "type": "boolean" },
        "path": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "acceptanceRows": {
      "type": "object",
      "additionalProperties": true,
      "required": ["updated", "reason"],
      "properties": {
        "updated": { "const": false },
        "reason": { "type": "string" }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["error", "warning", "info"] },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "kind", "message"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["command", "guidance"] },
          "message": { "type": "string" },
          "command": { "type": "string" }
        }
      }
    }
  }
}
