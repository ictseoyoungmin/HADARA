{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.dashboard.bootstrap.v1",
  "x-hadara-schema-id": "hadara.dashboard.bootstrap.v1",
  "type": "object",
  "required": ["schemaVersion", "command", "ok", "generatedAt", "source", "cache", "status", "taskSummary", "timelineOverview", "activeRunSummary", "debtSummary", "selectedTask", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.dashboard.bootstrap.v1" },
    "command": { "const": "dashboard.bootstrap" },
    "ok": { "type": "boolean" },
    "generatedAt": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["kind", "label", "projectRoot"],
      "properties": {
        "kind": { "const": "live-api" },
        "label": { "type": "string" },
        "projectRoot": { "type": "string" }
      }
    },
    "cache": {
      "type": "object",
      "required": ["status", "key", "ttlMs", "generatedAt", "expiresAt"],
      "properties": {
        "status": { "enum": ["hit", "miss", "stale", "bypass", "disabled"] },
        "key": { "type": "string" },
        "ttlMs": { "type": ["number", "null"] },
        "generatedAt": { "type": "string" },
        "expiresAt": { "type": ["string", "null"] }
      }
    },
    "status": { "type": "object" },
    "taskSummary": {
      "type": "object",
      "required": ["total", "counts", "rawStatusCounts", "normalizedStatusCounts", "lastCompleted", "nextRecommended", "recent"],
      "properties": {
        "total": { "type": "number" },
        "counts": { "type": "object" },
        "rawStatusCounts": { "type": "object" },
        "normalizedStatusCounts": { "type": "object" },
        "lastCompleted": { "type": "array" },
        "nextRecommended": { "type": ["string", "null"] },
        "recent": { "type": "array" }
      }
    },
    "timelineOverview": {
      "type": "object",
      "required": ["schemaVersion", "ok", "events", "issues"],
      "properties": {
        "schemaVersion": { "const": "hadara.dashboard.timeline.v1" },
        "ok": { "type": "boolean" },
        "events": { "type": "array" },
        "issues": { "type": "array" }
      }
    },
    "activeRunSummary": {
      "type": "object",
      "required": ["ok", "present", "taskId", "status", "staleReason", "issues"],
      "properties": {
        "ok": { "type": "boolean" },
        "present": { "type": "boolean" },
        "taskId": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "staleReason": { "type": ["string", "null"] },
        "issues": { "type": "number" }
      }
    },
    "debtSummary": { "type": "object" },
    "selectedTask": {
      "type": ["object", "null"],
      "properties": {
        "requestedTaskId": { "type": "string" },
        "ok": { "type": "boolean" },
        "task": { "type": ["object", "null"] },
        "state": { "type": "object" },
        "proof": { "type": "object" },
        "issues": { "type": "array" }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["warning", "error"] },
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
