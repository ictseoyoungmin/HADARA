{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.init.plan.v1",
  "x-hadara-schema-id": "hadara.init.plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "projectMode", "preset", "actions", "summary", "planHash"],
  "properties": {
    "schemaVersion": { "const": "hadara.init.plan.v1" },
    "operation": { "const": "init" },
    "projectMode": { "enum": ["greenfield", "brownfield", "initialized", "partial", "legacy", "unsafe"] },
    "preset": { "enum": ["minimal", "standard", "governed"] },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "planHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "management", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "create",
            "insert-managed-block",
            "update-managed-block",
            "replace-hadara-managed",
            "append-line",
            "register",
            "migrate",
            "regenerate",
            "preserve",
            "skip",
            "conflict"
          ]
        },
        "management": {
          "enum": [
            "hadara-managed",
            "mixed-managed-block",
            "command-managed",
            "scaffold-once",
            "generated-projection",
            "mixed-append"
          ]
        },
        "reason": { "type": "string", "minLength": 1 },
        "beforeHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "updateManaged", "append", "register", "migrate", "preserve", "skip", "conflict", "delete"],
      "properties": {
        "create": { "type": "integer", "minimum": 0 },
        "updateManaged": { "type": "integer", "minimum": 0 },
        "append": { "type": "integer", "minimum": 0 },
        "register": { "type": "integer", "minimum": 0 },
        "migrate": { "type": "integer", "minimum": 0 },
        "preserve": { "type": "integer", "minimum": 0 },
        "skip": { "type": "integer", "minimum": 0 },
        "conflict": { "type": "integer", "minimum": 0 },
        "delete": { "const": 0 }
      }
    }
  }
}
