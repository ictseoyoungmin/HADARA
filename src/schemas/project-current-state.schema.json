{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.projectCurrentState.v1",
  "x-hadara-schema-id": "hadara.projectCurrentState.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rev", "profile", "currentRelease", "latestCompletedTask", "activeTask", "nextWork", "nextOperatorIntent", "continuation", "currentKnownProblems", "validationBaseline"],
  "properties": {
    "schemaVersion": { "const": "hadara.projectCurrentState.v1" },
    "rev": { "type": "integer", "minimum": 1 },
    "profile": { "enum": ["basic", "standard", "governed"] },
    "currentRelease": { "type": "string", "minLength": 1 },
    "latestCompletedTaskBasis": {
      "const": "highest-done-task-id",
      "description": "latestCompletedTask is the highest Task Board Done task id. It is not close timestamp chronology."
    },
    "latestCompletedTask": { "$ref": "#/$defs/taskRefOrNull" },
    "activeTask": { "$ref": "#/$defs/taskRefOrNull" },
    "nextWork": {
      "anyOf": [
        { "$ref": "#/$defs/nextWork" },
        { "type": "null" }
      ]
    },
    "nextOperatorIntent": { "type": "string", "minLength": 1 },
    "continuation": {
      "anyOf": [
        { "$ref": "#/$defs/continuation" },
        { "type": "null" }
      ]
    },
    "currentKnownProblems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "state", "guidance"],
        "properties": {
          "summary": { "type": "string", "minLength": 1 },
          "state": { "enum": ["watch", "active", "blocked"] },
          "guidance": { "type": "string", "minLength": 1 }
        }
      }
    },
    "validationBaseline": {
      "type": "object",
      "description": "Current trusted validation baseline for resuming work. This is not required to be the latest completed task's evidence.",
      "additionalProperties": false,
      "required": ["summary", "evidence"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "kind", "title"],
      "properties": {
        "disposition": { "enum": ["actionable", "waiting-for-operator", "blocked", "terminal", "unresolved"] },
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" },
        "createCommandAllowed": { "type": "boolean" },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "required"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" }
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "workId", "path"],
          "properties": {
            "type": { "const": "work-handoff" },
            "workId": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "nextWork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "state", "operatorGuidance", "createCommandAllowed", "origin"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "state": { "enum": ["candidate", "active", "blocked", "waiting-for-operator", "none"] },
        "operatorGuidance": { "type": "string" },
        "createCommandAllowed": { "type": "boolean" },
        "origin": { "enum": ["bootstrap-first-task", "bootstrap-adoption-baseline", "declared"] }
      }
    },
    "taskRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^T-[0-9]{4,}$" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "taskRefOrNull": {
      "anyOf": [
        { "$ref": "#/$defs/taskRef" },
        { "type": "null" }
      ]
    }
  }
}
