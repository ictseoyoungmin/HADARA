{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.handoff.suggestion.v1",
  "x-hadara-schema-id": "hadara.handoff.suggestion.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "command", "ok", "readOnly", "generatedAt", "actor", "target", "task", "sections", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.handoff.suggestion.v1" },
    "command": { "const": "handoff.suggest" },
    "ok": { "type": "boolean" },
    "readOnly": { "const": true },
    "generatedAt": { "type": "string" },
    "actor": {
      "type": "object",
      "additionalProperties": true,
      "required": ["agentId", "runId", "role", "parentRunId"],
      "properties": {
        "agentId": { "type": "string" },
        "runId": { "type": "string" },
        "role": { "enum": ["operator", "coordinator", "worker", "reviewer", "unknown"] },
        "parentRunId": { "type": ["string", "null"] }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "beforeHash", "writeBoundary", "recommendedActorRole"],
      "properties": {
        "path": { "const": "docs/AGENT_HANDOFF.md" },
        "beforeHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "writeBoundary": { "const": "shared-doc" },
        "recommendedActorRole": { "const": "coordinator" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": true,
      "required": ["taskId"],
      "properties": {
        "taskId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "capsulePath": { "type": "string" }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "heading", "action", "summary"],
        "properties": {
          "id": { "enum": ["current-state", "last-completed", "known-problems", "next-recommended-step", "validation-baseline"] },
          "heading": { "type": "string" },
          "sectionTitle": { "type": "string" },
          "action": { "enum": ["replace-row", "append-row", "manual-review"] },
          "summary": { "type": "string" },
          "targetBeforeHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "suggestedReplacementMarkdown": { "type": "string" },
          "suggestedMarkdown": { "type": "string" }
        }
      }
    },
    "patchPreview": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "format": { "enum": ["unified-diff", "section-fragments"] },
        "content": { "type": "string" }
      }
    },
    "issues": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  }
}
