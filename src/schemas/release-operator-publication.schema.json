{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.releaseOperatorPublication.v1",
  "x-hadara-schema-id": "hadara.releaseOperatorPublication.v1",
  "title": "HADARA Release Operator Publication Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "package", "github", "lineage", "mutationBoundary", "commands"],
  "properties": {
    "schemaVersion": { "const": "hadara.releaseOperatorPublication.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "package": { "$ref": "#/$defs/package" },
    "github": { "$ref": "#/$defs/github" },
    "lineage": { "$ref": "#/$defs/lineage" },
    "mutationBoundary": { "$ref": "#/$defs/mutationBoundary" },
    "commands": { "$ref": "#/$defs/commands" }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "registry", "distTag", "npmMutationPerformed", "observedVersion", "distTagsBefore", "distTagsAfter"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "registry": { "type": "string", "format": "uri" },
        "distTag": { "type": "string", "minLength": 1 },
        "npmMutationPerformed": { "const": true },
        "observedVersion": { "type": "string", "minLength": 1 },
        "distTagsBefore": { "$ref": "#/$defs/distTags" },
        "distTagsAfter": { "$ref": "#/$defs/distTags" }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationPerformed", "draftRequested", "prerelease", "assets"],
      "properties": {
        "mutationPerformed": { "type": "boolean" },
        "draftRequested": { "type": "boolean" },
        "prerelease": { "type": "boolean" },
        "assets": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/asset" }
        }
      }
    },
    "distTags": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "uploaded"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "uploaded": { "type": "boolean" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "sourceCommit", "approvalActor", "approvalReason"],
      "properties": {
        "taskId": { "type": "string", "pattern": "^T-[0-9]+$" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
        "approvalActor": { "type": "string", "minLength": 1 },
        "approvalReason": { "type": "string", "minLength": 1 }
      }
    },
    "mutationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dockerMutationPerformed", "stableLatestMutationPerformed", "substituteArtifactUsed"],
      "properties": {
        "dockerMutationPerformed": { "const": false },
        "stableLatestMutationPerformed": { "type": "boolean" },
        "substituteArtifactUsed": { "const": false }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npmPublish", "githubRelease"],
      "properties": {
        "npmPublish": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "githubRelease": {
          "anyOf": [
            { "type": "null" },
            { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          ]
        }
      }
    }
  }
}
