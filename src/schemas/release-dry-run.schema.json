{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.releaseDryRun.v1",
  "x-hadara-schema-id": "hadara.releaseDryRun.v1",
  "title": "HADARA Release Dry Run Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "command",
    "mode",
    "ok",
    "current",
    "releaseTargets",
    "checks",
    "evidence",
    "plannedSteps",
    "providerCapabilities",
    "privacy",
    "issues"
  ],
  "properties": {
    "schemaVersion": { "const": "hadara.releaseDryRun.v1" },
    "command": { "const": "release.dryRun" },
    "mode": { "const": "dry-run" },
    "ok": { "type": "boolean" },
    "current": {
      "type": "object",
      "additionalProperties": true,
      "required": ["packageName", "packageVersion"],
      "properties": {
        "packageName": { "type": "string", "minLength": 1 },
        "packageVersion": { "type": "string", "minLength": 1 },
        "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "releaseTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "dockerImage"],
      "properties": {
        "primary": { "const": "npm-package" },
        "secondary": { "const": "github-release" },
        "dockerImage": { "const": "deferred" },
        "descriptors": {
          "type": "array",
          "items": { "$ref": "#/$defs/releaseTargetDescriptor" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "plannedSteps": {
      "type": "array",
      "items": { "$ref": "#/$defs/plannedStep" }
    },
    "providerCapabilities": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/providerCapabilities" }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "blockers", "warnings", "nextActions"],
      "properties": {
        "status": { "type": "string", "enum": ["ready", "blocked"] },
        "blockers": { "type": "number" },
        "warnings": { "type": "number" },
        "nextActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/nextAction" }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generatedAt", "durationMs", "stageTimings", "slowStageWarnings"],
      "properties": {
        "generatedAt": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "number" },
        "stageTimings": {
          "type": "array",
          "items": { "$ref": "#/$defs/stageTiming" }
        },
        "slowStageWarnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/slowStageWarning" }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "tokenValuesIncluded",
        "rawLogsIncluded",
        "privatePathsIncluded",
        "publishExecuted",
        "githubReleaseCreated",
        "dockerImageBuilt"
      ],
      "properties": {
        "tokenValuesIncluded": { "const": false },
        "rawLogsIncluded": { "const": false },
        "privatePathsIncluded": { "const": false },
        "publishExecuted": { "const": false },
        "githubReleaseCreated": { "const": false },
        "dockerImageBuilt": { "const": false }
      }
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "name", "status", "summary"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["passed", "warning", "error"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "releaseTargetDescriptor": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "ecosystem", "role", "status", "manifestPath", "artifactKinds", "smokeProfile", "publishDeferred", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ecosystem": { "type": "string", "enum": ["npm", "python", "docker", "github-release", "generic-archive", "cargo", "maven"] },
        "role": { "type": "string", "enum": ["primary", "secondary", "deferred", "preview"] },
        "status": { "type": "string", "enum": ["active", "deferred", "preview"] },
        "manifestPath": { "type": "string", "minLength": 1 },
        "packageName": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "artifactKinds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "smokeProfile": { "type": "string", "minLength": 1 },
        "publishProvider": { "type": "string", "minLength": 1 },
        "publishDeferred": { "type": "boolean" },
        "buildBackend": { "type": "string", "enum": ["setuptools", "poetry", "hatch", "flit", "unknown"] },
        "plannedCommands": {
          "type": "array",
          "items": { "$ref": "#/$defs/providerPlannedCommand" }
        },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "providerPlannedCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "willExecute", "purpose", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "willExecute": { "const": false },
        "purpose": { "type": "string", "enum": ["build", "check", "smoke"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "providerCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detect", "buildPlan", "smokePlan", "artifactPlan", "publishPlan", "notes"],
      "properties": {
        "detect": { "$ref": "#/$defs/providerSupport" },
        "buildPlan": { "$ref": "#/$defs/providerSupport" },
        "smokePlan": { "$ref": "#/$defs/providerSupport" },
        "artifactPlan": { "$ref": "#/$defs/providerSupport" },
        "publishPlan": { "$ref": "#/$defs/providerSupport" },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "providerSupport": {
      "type": "string",
      "enum": ["supported", "preview", "unsupported"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "artifactExists"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["PACKAGE_SMOKE_EVIDENCE", "CLEAN_CHECKOUT_SMOKE_EVIDENCE", "RELEASE_ARTIFACT_EVIDENCE"]
        },
        "taskId": { "type": "string", "pattern": "^T-[0-9]{4}$" },
        "time": { "type": "string", "minLength": 1 },
        "evidencePath": { "type": "string", "minLength": 1 },
        "artifactExists": { "type": "boolean" },
        "artifactSchemaValid": { "type": "boolean" },
        "sourceOk": { "type": "boolean" },
        "category": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 },
        "packageVersion": { "type": "string", "minLength": 1 },
        "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "manifestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "plannedStep": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "target", "willExecute", "requiresApproval", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "enum": ["npm-package", "github-release", "docker-image"] },
        "willExecute": { "const": false },
        "requiresApproval": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "required", "reason", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "stageTiming": {
      "type": "object",
      "additionalProperties": true,
      "required": ["stage", "durationMs", "status", "summary"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "number" },
        "status": { "type": "string", "enum": ["passed", "warning", "error"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "slowStageWarning": {
      "type": "object",
      "additionalProperties": true,
      "required": ["stage", "durationMs", "thresholdMs", "summary"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "number" },
        "thresholdMs": { "type": "number" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": true,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "type": "string", "enum": ["warning", "error"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
