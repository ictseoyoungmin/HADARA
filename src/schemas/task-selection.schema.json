{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hadara.task.selection.v1",
  "x-hadara-schema-id": "hadara.task.selection.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "command", "ok", "projectRoot", "summary", "recommendations", "sources", "issues"],
  "properties": {
    "schemaVersion": { "const": "hadara.task.selection.v1" },
    "command": { "const": "task.selection" },
    "ok": { "type": "boolean" },
    "projectRoot": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "policy": { "const": "markdown-first" }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "sourceKind": { "enum": ["development-slices", "task-board-fallback", "task-handoff-continuation"] }
        }
      }
    },
    "backlog": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "sources": { "type": "object", "additionalProperties": true },
    "issues": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  }
}
